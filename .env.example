# Frontend (written by `npx convex dev` into .env.local)
VITE_CONVEX_URL=

# Backend env vars are set on the Convex deployment, not in this file:
#   npx convex env set OPENAI_API_KEY=...
#   npx convex env set FIRECRAWL_API_KEY=...
#   npx convex env set AGENTMAIL_API_KEY=...
#   npx convex env set AGENTMAIL_WEBHOOK_SECRET=whsec_...
#   npx convex env set AGENTMAIL_INBOX_DOMAIN=agentmail.to      (optional)
#   npx convex env set AGENTMAIL_FALLBACK_INBOX_ID=...           (optional shared inbox)
#   npx convex env set SITE_URL=http://localhost:5173
#   JWT_PRIVATE_KEY / JWKS generated with jose (see docs/PLAN.md)
