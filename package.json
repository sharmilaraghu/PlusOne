{
  "name": "plusone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,convex -c cyan,magenta \"vite\" \"convex dev\"",
    "dev:web": "vite",
    "dev:convex": "convex dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "deploy": "npx convex deploy --cmd 'npm run build' && npx @convex-dev/static-hosting deploy"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.67",
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/static-hosting": "^0.2.1",
    "@convex-dev/workflow": "^0.4.8",
    "@convex-dev/workpool": "^0.4.12",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "agentmail": "^0.5.25",
    "ai": "^7.0.102",
    "convex": "^1.45.0",
    "fflate": "^0.8.3",
    "firecrawl": "^4.40.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "jose": "^6.0.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^8.3.0"
  }
}
